generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WorkMode {
  REMOTE
  HYBRID
  ON_SITE
}

enum UniversityType {
  PUBLIC
  PRIVATE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model City {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(80)

  companies    Company[]
  internships  Internship[]
  universities University[]

  @@map("cities")
}

model Company {
  id               Int      @id @default(autoincrement())
  slug             String   @unique @db.VarChar(80)
  name             String   @db.VarChar(120)
  shortDescription String? @db.VarChar(255)
  industry         String   @db.VarChar(80)
  foundedYear      Int @db.SmallInt
  website          String?  @db.VarChar(255)
  isPartner        Boolean  @default(false)
  displayOrder     Int      @default(0)
  cityId           Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  city        City         @relation(fields: [cityId], references: [id])
  internships Internship[]
  stories     Story[]

  @@index([cityId])
  @@index([isPartner, displayOrder])
  @@map("companies")
}

model Internship {
  id             Int      @id @default(autoincrement())
  slug           String   @unique @db.VarChar(120)
  title          String   @db.VarChar(160)
  description    String   @db.Text
  workMode       WorkMode
  durationMonths Int @db.TinyInt
  schedule       String?  @db.VarChar(160)
  paid           Boolean  @default(false)
  stipend        Decimal? @db.Decimal(8, 2)
  opensAt        DateTime @db.Date
  closesAt       DateTime @db.Date
  seats          Int      @db.SmallInt
  featured       Boolean  @default(false)
  companyId      Int
  cityId         Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  city    City              @relation(fields: [cityId], references: [id])
  skills  InternshipSkill[]

  @@index([companyId])
  @@index([cityId])
  @@index([featured])
  @@map("internships")
}

model Skill {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(80)

  internships InternshipSkill[]

  @@map("skills")
}

model InternshipSkill {
  internshipId Int
  skillId      Int
  position     Int @default(0) @db.TinyInt

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([internshipId, skillId])
  @@index([skillId])
  @@map("internshipSkills")
}

model University {
  id        Int            @id @default(autoincrement())
  slug      String         @unique @db.VarChar(80)
  name      String         @db.VarChar(160)
  shortName String @db.VarChar(120)
  type      UniversityType
  logo      String?        @db.VarChar(255)
  website   String?        @db.VarChar(255)
  cityId    Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  city          City                  @relation(fields: [cityId], references: [id])
  verifications StudentVerification[]
  stories       Story[]

  @@index([cityId])
  @@map("universities")
}

model StudentVerification {
  id           Int                @id @default(autoincrement())
  reference    String             @unique @db.VarChar(40)
  studentEmail String @db.VarChar(160)
  studentName  String @db.VarChar(120)
  status       VerificationStatus @default(PENDING)
  submittedAt  DateTime
  decidedAt    DateTime?
  universityId Int

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId, status])
  @@index([studentEmail])
  @@map("studentVerifications")
}

model Story {
  id               Int      @id @default(autoincrement())
  slug             String   @unique @db.VarChar(120)
  title            String   @db.VarChar(160)
  excerpt          String   @db.VarChar(255)
  category         String   @db.VarChar(40)
  field            String   @db.VarChar(80)
  position         String   @db.VarChar(160)
  authorName       String? @db.VarChar(120)
  authorUniversity String? @db.VarChar(160)
  anonymous        Boolean  @default(false)
  verified         Boolean  @default(false)
  featured         Boolean  @default(false)
  publishedAt      DateTime
  companyId        Int?
  universityId     Int?
  createdAt        DateTime @default(now())

  company    Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  university University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([companyId])
  @@index([universityId])
  @@map("stories")
}

model Admin {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(160)
  name         String    @db.VarChar(120)
  passwordHash String    @db.VarChar(255)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admins")
}
